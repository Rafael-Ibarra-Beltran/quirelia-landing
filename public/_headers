/assets/*
  Cache-Control: public, max-age=31536000, immutable
/art/*
  Cache-Control: public, max-age=2592000
/brand/*
  Cache-Control: public, max-age=2592000
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  # The sha256 is the inline script in index.html: recompute it if that script changes.
  # When config.formEndpoint is set, add its origin to connect-src.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-9BNalyCrYXRbnG0Nhb72dMFYl8J1UQoFxrMUKX7tJEk='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
