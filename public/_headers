/assets/*
  Cache-Control: public, max-age=31536000, immutable
/art/*
  Cache-Control: public, max-age=2592000
/brand/*
  Cache-Control: public, max-age=2592000
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  ! Access-Control-Allow-Origin
  # The sha256 is the inline script in index.html: recompute it if that script changes.
  # When config.formEndpoint is set, add its origin to connect-src.
  # Report-Only: Trusted Types is not enforced yet. Cloudflare injects email-decode.min.js (email obfuscation), which was not part of the local test.
  # Open the console on the live site: with no violations, move require-trusted-types-for into the Content-Security-Policy above.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-9BNalyCrYXRbnG0Nhb72dMFYl8J1UQoFxrMUKX7tJEk='; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Content-Security-Policy-Report-Only: require-trusted-types-for 'script'
